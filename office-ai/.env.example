# Copy this file to .env (or let app.py auto-create it and just paste
# keys into the sidebar — either works). Never commit the real .env file.

# --- AI provider keys (only need the one you're using) ---
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# --- Review Queue backend connection (Phase 3) ---
# Only needed if you're using the Review Queue page. Point this at your
# running halohubx-api backend (local or deployed), and use a partner API
# key generated by that project's create_partner.py script.
HALOHUBX_BACKEND_URL=http://127.0.0.1:8000
HALOHUBX_PARTNER_API_KEY=hhx_your_partner_key_here
