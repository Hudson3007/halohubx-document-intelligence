# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit secrets.

# Supabase Postgres connection string (see README "Set up a database"):
# postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Database security guardrails (see app/db.py) ---
# Refuse to connect as a DB superuser (postgres/admin/root) unless set. Use a
# least-privilege app role in production; set to 1 only for throwaway local DBs.
ALLOW_SUPERUSER_DB=false
# Force TLS for remote Postgres unless set. Leave false in production.
DB_SSL_DISABLE=false

# AI provider: "gemini" or "claude"
DEFAULT_AI_PROVIDER=gemini

# Reuse the same keys as the Streamlit app (the source app).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Webhook retry behaviour
WEBHOOK_MAX_RETRIES=3

# Below this confidence a field is flagged for human review (HITL)
LOW_CONFIDENCE_THRESHOLD=0.85

# --- Upload safety ---
# Hard cap on the size of an uploaded PDF (bytes). 25 MB default.
MAX_UPLOAD_BYTES=26214400

# --- Original PDF storage ---
# Backend for retaining source PDFs (side-by-side review preview).
#   disk     - write under UPLOAD_DIR (default; suited to a durable FS / local dev)
#   supabase - persist in a Supabase Storage bucket so files survive ephemeral
#              hosts (Render free tier wipes disk on restart/sleep).
# When UPLOAD_STORAGE=supabase you must supply SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY, and create a Storage bucket named UPLOAD_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_STORAGE=disk
UPLOAD_BUCKET=halohubx-uploads

# --- Webhook SSRF guard ---
# Webhook targets must be public https URLs. For LOCAL DEV ONLY you can allow
# http://localhost / http://127.0.0.1 webhooks with this flag (never private
# ranges, metadata, or RFC1918 hosts regardless of this setting).
ALLOW_HTTP_LOOPBACK_WEBHOOKS=false

# --- Auth hardening ---
# Console session tokens expire after N hours; re-login to refresh.
SESSION_TOKEN_TTL_HOURS=12
# Lock the console login after this many consecutive failed password attempts.
LOGIN_MAX_ATTEMPTS=5
# Lockout window (minutes) once the failure cap is hit.
LOGIN_LOCKOUT_MINUTES=15
# Coarse in-process rate cap for /auth endpoints (requests/min per client IP).
AUTH_RATE_LIMIT_PER_MIN=20

# --- Observability ---
# Emit one structured JSON object per log line (container default). Set to 0
# for human-readable text in local dev.
LOG_JSON=1
# Root log level: INFO (default), DEBUG, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Backup / DR (see scripts/db_backup.sh + db_restore.sh) ---
# DB to dump nightly (compose or cloud/Supabase URL).
# BACKUP_DATABASE_URL=postgresql://halohubx:PASSWORD@db:5432/halohubx
# How many dumps to keep before pruning.
# BACKUP_KEEP=14

# --- Billing / payments (Phase 3b, Razorpay) ---
# Price per credit (1 credit = 1 PDF page) in Indian paise. PLACEHOLDER for
# Profezzo to set. 200 paise = INR 2/page.
# CREDIT_PRICE_PAISE=200
# PAYMENTS_CURRENCY=INR

# Razorpay merchant keys (NOT set in dev). When set, real checkout + webhooks
# work; when unset, use POST /billing/dev/simulate to test crediting locally.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Subscription plans: monthly credit quota per plan tier.
# PLAN_QUOTA_STARTER=1000
# PLAN_QUOTA_GROWTH=5000
# PLAN_QUOTA_SCALE=20000

# Dev/demo gate: exposes POST /billing/dev/simulate so billing can be tested
# WITHOUT a Razorpay merchant. MUST be off in production (never enable there).
# ENABLE_DEV_PAYMENTS=true

